# Must match backend/.env API_KEY — sent as the x-api-key header.
# Optional: set full API URL only if you do not use the Vite dev proxy.
# VITE_API_BASE=http://localhost:9600
VITE_API_KEY=

# Optional: where Vite proxies /api in dev (Node only; see vite.config.js).
# DEV_API_PROXY_TARGET=http://127.0.0.1:9600

# Docker / nginx: empty API base uses same-origin /api proxy (set in frontend/Dockerfile).
# VITE_USE_PROXY=true
