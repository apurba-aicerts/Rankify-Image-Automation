GOOGLE_API_KEY=""
# Required. Clients send this same value in the x-api-key header.
API_KEY=""
# Gallery history: delete generated images older than this (default 720 = 30 days)
IMAGE_TTL_HOURS=720
# Optional: absolute URL of this API for signed image links (e.g. behind reverse proxy). If empty, request Host is used.
PUBLIC_BASE_URL=
# Optional: directory for persisted images (default: ./generated-images)
LOCAL_IMAGE_STORAGE_DIR=
# Optional: directory for brand JSON + assets (default: ./data/brands)
BRAND_DATA_DIR=
# Log level for backend services (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# 1 = write full prompt/colors/fonts audit .txt under generated-images/<brand_id>/_audit/ each run; 0 = off
RANKIFY_GENERATION_AUDIT=1
# Optional. OpenAI: brand AI draft, social copy, and image models (openai:gpt-image-* on /api/generate and gallery edit).
OPENAI_API_KEY=

# --- Production persistence (optional; omit for local filesystem-only mode) ---
# PostgreSQL connection string (enables DB-backed brands, gallery metadata, social copy history)
DATABASE_URL=postgresql+psycopg://rankify:rankify@localhost:5434/rankify
# local = disk gallery; s3 = AWS S3/R2 (requires DATABASE_URL)
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
S3_GALLERY_PREFIX=gallery/
S3_BRAND_ASSETS_PREFIX=brands/
S3_PRESIGN_TTL_SECONDS=3600